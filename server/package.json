{
  "name": "streakhabit-server",
  "version": "1.0.0",
  "description": "Duolingo-style Habits & Task Duration Tracker Backend with Node.js and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node -e 'const fs=require(\"fs\"),db=require(\"./db\");db.query(fs.readFileSync(\"./db/schema.sql\",\"utf8\")).then(()=>{console.log(\"Migrations complete\");process.exit(0);}).catch(e=>{console.error(e);process.exit(1);})'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
